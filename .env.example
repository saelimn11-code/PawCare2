PORT=3001
PUBLIC_BASE_URL=http://localhost:3001

# Google OAuth web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# LINE Login channel
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=http://localhost:3001/auth/line/callback

# Facebook Login app
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3001/auth/facebook/callback
# Optional. Defaults to v23.0.
FACEBOOK_GRAPH_API_VERSION=v23.0

# Optional TheCatAPI key for server-side image requests.
THECATAPI_API_KEY=

# Google Gemini image analysis (create a key at https://aistudio.google.com/apikey)
# Add the key to your local .env file and restart the server.
GEMINI_API_KEY=
